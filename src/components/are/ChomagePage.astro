---
/**
 * Gabarit des pages chômage (ARE), français à la racine et anglais sous /en/.
 * Ordre (RECETTE §5, §9.3, §21) : fil d'Ariane, H1, chapeau, bloc citable de 120 mots et plus,
 * simulateur (slot « sim »), contenu propre à la page, FAQ (une seule liste → visible + FAQPage),
 * pages voisines et sources officielles (data-chrome : identiques par construction).
 */
import Layout from '../../layouts/Layout.astro';
import P from '../../data/params-are-2026.json';

export interface QA { q: string; a: string }
interface Props {
  lang: 'fr' | 'en';
  path: string;
  alt: string;
  title: string;
  description: string;
  h1: string;
  lede: string;
  citable: string;
  faq: QA[];
  crumb: string;
  sources: Array<keyof typeof P.sources>;
  /** Page outil : le simulateur passe avant le bloc citable, pour être visible sans défiler sur mobile (§5). */
  simFirst?: boolean;
}
const { lang, path, alt, title, description, h1, lede, citable, faq, crumb, sources, simFirst = false } = Astro.props;
const en = lang === 'en';
const site = 'https://indemnitelicenciement.fr';
const PAGES_FR = [
  ['/simulateur-chomage/', 'Simulateur chômage ARE 2026'],
  ['/simulateur-chomage/apres-licenciement/', 'Chômage après un licenciement : date du premier versement'],
  ['/simulateur-chomage/rupture-conventionnelle/', 'Chômage et rupture conventionnelle'],
  ['/simulateur-chomage/droits-au-chomage/', 'Droits au chômage : conditions et durée'],
  ['/simulateur-chomage/demission/', 'Démission et chômage'],
  ['/simulateur-chomage/cumul-are-salaire/', 'Cumul ARE et salaire'],
  ['/simulateur-chomage/arce-creation-entreprise/', 'ARCE et création d’entreprise'],
  ['/simulateur-chomage/degressivite/', 'Dégressivité de l’ARE'],
  ['/', 'Calculateur d’indemnité de licenciement'],
];
const PAGES_EN = [
  ['/en/unemployment-benefit/', 'ARE unemployment benefit calculator 2026'],
  ['/en/unemployment-benefit/after-dismissal/', 'Benefit after a dismissal: first payment date'],
  ['/en/unemployment-benefit/rupture-conventionnelle/', 'Mutual termination and unemployment benefit'],
  ['/en/unemployment-benefit/eligibility/', 'Eligibility and length of entitlement'],
  ['/en/unemployment-benefit/resignation/', 'Resigning and unemployment benefit'],
  ['/en/unemployment-benefit/working-while-claiming/', 'Working while claiming ARE'],
  ['/en/unemployment-benefit/arce-starting-a-business/', 'ARCE: starting a business'],
  ['/en/unemployment-benefit/degressivity/', 'Degressivity for high earners'],
  ['/', 'Severance pay calculator (in French)'],
];
const voisins = (en ? PAGES_EN : PAGES_FR).filter(([h]) => h !== path);
const racine = en ? '/en/unemployment-benefit/' : '/simulateur-chomage/';
const ariane = path === racine
  ? [[en ? '/' : '/', en ? 'Home' : 'Accueil'], [path, crumb]]
  : [[en ? '/' : '/', en ? 'Home' : 'Accueil'], [racine, en ? 'Unemployment benefit' : 'Simulateur chômage'], [path, crumb]];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: ariane.map(([h, n], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: `${site}${h}` })) },
    { '@type': 'Article', headline: h1, inLanguage: lang, dateModified: P.retrieved_at, author: { '@type': 'Organization', name: 'Radif Partners', url: `${site}/a-propos/` }, publisher: { '@id': `${site}/#org` }, mainEntityOfPage: `${site}${path}` },
    { '@type': 'FAQPage', mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
  ],
};
---
<Layout title={title} description={description} canonical={path} lang={lang} alternates={en ? { fr: alt, en: path } : { fr: path, en: alt }} schema={schema}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav data-chrome aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'} class="text-sm text-gray-600">
      {ariane.map(([h, n], i) => (
        <span>{i > 0 && <span aria-hidden="true"> › </span>}{i < ariane.length - 1 ? <a href={h} class="text-primary-700 hover:underline">{n}</a> : <span aria-current="page">{n}</span>}</span>
      ))}
    </nav>
    <h1 class="mt-4 text-3xl md:text-4xl font-extrabold text-gray-900">{h1}</h1>
    <p class="mt-3 text-lg text-gray-700">{lede}</p>
    {simFirst && <div class="mt-6"><slot name="sim" /></div>}
    <p class="mt-6 leading-relaxed text-gray-800">{citable}</p>
    {!simFirst && <div class="mt-6"><slot name="sim" /></div>}
  </div>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 chomage-prose">
    <slot />
  </article>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12" aria-labelledby="faq">
    <h2 id="faq" class="text-2xl font-bold text-gray-900">{en ? 'Questions people ask' : 'Questions fréquentes'}</h2>
    <div class="mt-4 space-y-3">
      {faq.map((x) => (
        <details class="rounded-lg border border-gray-200 bg-white">
          <summary class="cursor-pointer px-5 py-3 font-semibold text-gray-900">{x.q}</summary>
          <p class="px-5 pb-4 text-gray-700 leading-relaxed">{x.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section data-chrome class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12" aria-labelledby="voisins">
    <h2 id="voisins" class="text-2xl font-bold text-gray-900">{en ? 'Related calculators' : 'Simulateurs associés'}</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {voisins.map(([h, n]) => <li><a href={h} class="text-primary-700 hover:underline">{n}</a></li>)}
    </ul>
  </section>

  <section data-chrome class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12" aria-labelledby="sources">
    <h2 id="sources" class="text-2xl font-bold text-gray-900">{en ? 'Official sources' : 'Sources officielles'}</h2>
    <p class="mt-2 text-sm text-gray-600">{en ? `Read and checked on ${P.retrieved_at}. Amounts are taken from the parameter file used by the calculator.` : `Lues et vérifiées le ${P.retrieved_at}. Les montants viennent du fichier de paramètres du simulateur.`}</p>
    <ul class="mt-3 space-y-1 text-sm">
      {sources.map((k) => <li><a href={P.sources[k].url} rel="nofollow noopener" class="text-primary-700 hover:underline">{P.sources[k].label}</a></li>)}
    </ul>
  </section>
</Layout>
