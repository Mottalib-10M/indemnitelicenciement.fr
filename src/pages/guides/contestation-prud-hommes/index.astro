---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quel est le délai pour contester un licenciement aux prud'hommes ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le délai de prescription pour contester un licenciement est de 12 mois à compter de la notification du licenciement (article L.1471-1 du Code du travail). Ce délai s'applique à toute contestation portant sur la rupture du contrat de travail. Pour les actions en paiement de salaires, le délai est de 3 ans."
      }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que le barème Macron et combien peut-on obtenir ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le barème Macron (article L.1235-3 du Code du travail) fixe des planchers et plafonds d'indemnisation en cas de licenciement sans cause réelle et sérieuse, en fonction de l'ancienneté du salarié et de la taille de l'entreprise. Il va d'un plancher de 1 mois de salaire (0 an d'ancienneté dans les entreprises de 11+ salariés) à un plafond de 20 mois de salaire (29+ ans d'ancienneté)."
      }
    },
    {
      "@type": "Question",
      "name": "Peut-on contester un licenciement sans avocat ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. Le recours à un avocat n'est pas obligatoire devant le conseil de prud'hommes en première instance. Le salarié peut se faire assister ou représenter par un salarié de son entreprise, un délégué syndical ou un défenseur syndical inscrit sur une liste départementale. L'aide juridictionnelle est disponible pour les salariés aux revenus modestes."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://indemnite-licenciement.fr/" },
