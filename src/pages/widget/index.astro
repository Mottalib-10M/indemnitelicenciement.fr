---
import Layout from '../../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://indemnitelicenciement.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Widget", "item": "https://indemnitelicenciement.fr/widget/" }
  ]
};

const embedCode = `<iframe src="https://indemnitelicenciement.fr/embed/" width="100%" height="700" frameborder="0" style="border:none;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);" title="Widget d’indemnité de licenciement à intégrer gratuitement"></iframe>`;
import SourcesOfficielles from '../../components/SourcesOfficielles.astro';
---
<Layout title="Widget d’indemnité de licenciement à intégrer gratuitement" description="Intégrez gratuitement le simulateur d'indemnité de licenciement à votre site par une simple iframe, sans publicité, avec les barèmes officiels tenus à jour.">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-6xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-8">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-gray-700">Accueil</a></li>
        <li>/</li>
        <li class="text-gray-800 font-medium">Widget</li>
      </ol>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Integrer notre calculateur sur votre site</h1>
    <p class="text-gray-600 mb-8">Vous etes un professionnel du droit du travail, un CSE ou un site d'information juridique ? Integrez gratuitement notre calculateur d'indemnité de licenciement sur votre site en copiant le code ci-dessous.</p>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Code d'integration</h2>
      <p class="text-gray-600 mb-4">Copiez le code HTML suivant et collez-le dans votre page web à l'endroit ou vous souhaitez afficher le calculateur :</p>
      <div class="relative">
        <pre class="bg-gray-900 text-green-400 rounded-lg p-4 text-sm overflow-x-auto whitespace-pre-wrap break-words max-w-full" style="white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;max-width:100%"><code class="break-words">{embedCode}</code></pre>
        <button
          onclick="navigator.clipboard.writeText(this.closest('.relative').querySelector('code').textContent);this.textContent='Copie !';setTimeout(()=>this.textContent='Copier',2000)"
          class="absolute top-3 right-3 px-3 py-1 bg-gray-700 text-white text-xs rounded hover:bg-gray-600 transition-colors"
        >Copier</button>
      </div>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Comment l'integrer</h2>
      <ol class="space-y-4 text-gray-600">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-sm">1</span>
          <span><strong>Copiez le code</strong> : cliquez sur le bouton "Copier" ci-dessus pour copier le code iframe dans votre presse-papier.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-sm">2</span>
          <span><strong>Ouvrez votre editeur</strong> : accedez à l'editeur HTML de votre site, blog ou CMS (WordPress, Wix, Squarespace, etc.).</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-sm">3</span>
          <span><strong>Collez le code</strong> : inserez le code HTML à l'emplacement souhaite dans votre page, par exemple dans un article sur les droits des salariés.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-sm">4</span>
          <span><strong>Publiez</strong> : enregistrez et publiez votre page. Le calculateur s'affichera automatiquement et sera utilisable par vos visiteurs.</span>
        </li>
      </ol>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Options de personnalisation</h2>
      <div class="overflow-x-auto max-w-full">
        <table class="w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 font-semibold text-gray-700">Attribut</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Valeur par defaut</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr>
              <td class="px-4 py-3 font-mono text-blue-700">width</td>
              <td class="px-4 py-3">100%</td>
              <td class="px-4 py-3 text-gray-600">Largeur du widget. Accepte les pourcentages ou les pixels (ex: "800px").</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-mono text-blue-700">height</td>
              <td class="px-4 py-3">700</td>
              <td class="px-4 py-3 text-gray-600">Hauteur du widget en pixels. Augmentez cette valeur si le contenu est tronque.</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-mono text-blue-700">style</td>
              <td class="px-4 py-3">border-radius, box-shadow</td>
              <td class="px-4 py-3 text-gray-600">Styles CSS personnalisables. Modifiez les coins arrondis ou l'ombre selon votre charte graphique.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Apercu du widget</h2>
      <p class="text-gray-600 mb-4">Voici un apercu du calculateur tel qu'il apparaitra sur votre site :</p>
      <div class="border border-gray-200 rounded-lg overflow-hidden max-w-full">
        <iframe src="/embed/" width="100%" height="700" frameborder="0" loading="lazy" style="border:none;border-radius:8px;display:block;max-width:100%" title="Apercu du calculateur indemnité de licenciement"></iframe>
      </div>
    </section>
  </div>
  <SourcesOfficielles />
</Layout>
