import MiniSimAutonome from '../../../../components/calc/MiniSimAutonome';
import { V } from '../../../../lib/are-txt';
const v = V.en;
const faq = [
  { q: 'I am resigning to follow my partner who has been transferred. Can I claim?', a: `Yes, it is a legitimate resignation. It covers a spouse, civil partner (PACS) or cohabiting partner who moves for work: a transfer, a new job, a return to work after unemployment or starting a business. It does not apply if your partner is retiring or training as a jobseeker. Benefit is then calculated exactly as after a dismissal, with the same deferrals.` },
  { q: 'My employer has stopped paying me. Can I resign and get benefit?', a: `Yes, if you produce a decision of the employment tribunal (conseil de prud’hommes) ordering the employer to pay the wages owed; the resignation then counts as legitimate. Without a court decision, France Travail treats it as an ordinary resignation. Another route is to take formal note of the breach (prise d’acte) or ask the court to end the contract, which opens benefit if the judge rules it a dismissal.` },
  { q: 'What exactly happens after 121 days?', a: `If your resignation was not legitimate, you can ask, after ${v.dem121} days of unpaid unemployment, for the regional joint committee of France Travail to review your situation. It looks at your job search over those four months: applications, interviews, training. A positive decision opens benefit from day ${v.dem122}, without backdating. The period is extended by sick leave of 21 days or more.` },
  { q: 'How do I get a career-change project approved before resigning?', a: `Before resigning, you must get career advice (conseil en évolution professionnelle) from an approved provider such as Apec or Cap emploi, then have your project recognised as genuine and serious by the Transitions Pro committee of your region. You also need ${v.projetJours} days of continuous work in the last ${v.projetMois} months. Resigning before these steps closes this route.` },
  { q: 'I quit a job I had taken after being dismissed. Am I covered?', a: `Yes, if the new job lasted less than ${v.dem65} days and you had not registered with France Travail after the dismissal. Leaving a short job does not wipe out the right opened by the earlier involuntary loss. The same logic applies if you were already claiming and the new job lasted less than 88 days or 610 hours.` },
  { q: 'Is ending my probation period myself a resignation?', a: `For unemployment insurance, yes: ending a trial period on your own initiative is a voluntary departure. It does not remove your rights if the job lasted less than ${v.dem65} days and followed an involuntary job loss. When the employer ends the trial period, it is an involuntary loss, which opens benefit if you have worked enough.` },
];
