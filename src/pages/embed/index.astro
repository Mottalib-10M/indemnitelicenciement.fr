---
/**
 * Cible de l'iframe (RECETTE §13).
 *
 * La page /widget/ explique comment integrer le calculateur ; celle-ci est ce
 * que l'iframe charge reellement. Volontairement nue : pas d'en-tete, pas de
 * pied, pas de publicite, et `noindex` — sans quoi Google indexerait deux
 * pages pour un meme contenu, la seconde concurrencant la page d'accueil.
 *
 * Le lien d'attribution reste visible : c'est la contrepartie de la gratuite
 * de l'integration, et il s'ouvre dans une nouvelle fenetre pour ne pas
 * remplacer la page hote.
 */
import '../../styles/global.css';
import LicenciementCalculator from '../../components/LicenciementCalculator';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Calculateur d’indemnité de licenciement | Widget gratuit</title>
    <meta
      name="description"
      content="Version intégrable du calculateur d'indemnité de licenciement : indemnité légale, préavis et congés payés, sans publicité, pour insertion par iframe."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://indemnitelicenciement.fr/widget/" />
    <style>
      body { margin: 0; padding: 16px; background: #ffffff; }
    </style>
  </head>
  <body>
    <div class="max-w-4xl mx-auto">
      <LicenciementCalculator client:idle />
      <div class="mt-6 pt-4 border-t border-gray-200 text-center">
        <p class="text-xs text-gray-500">
          Calcul par
          <a
            href="https://indemnitelicenciement.fr/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 hover:text-primary-700 font-semibold"
          >Indemnité Licenciement</a>, barèmes du Code du travail 2026.
        </p>
      </div>
    </div>
  </body>
</html>
