---
import Layout from '../../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://indemnite-licenciement.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Glossaire", "item": "https://indemnite-licenciement.fr/glossaire/" }
  ]
};

const terms = [
  {
    term: "Anciennete",
    definition: "L'ancienneté correspond à la durée de presence du salarié dans l'entreprise, calculee à partir de la date d'embauche jusqu'à la date de notification du licenciement. Elle est determinante pour le calcul de l'indemnité de licenciement et la durée du préavis."
  },
  {
    term: "Brut/net fiscal",
    definition: "L'indemnité de licenciement peut etre exprimee en brut ou en net fiscal. La part exoneree d'impôt sur le revenu et de cotisations sociales depend de plafonds fixes par la loi. Au-dela de ces plafonds, l'excedent est soumis à l'impôt et aux prélèvements sociaux."
  },
  {
    term: "Convention collective",
    definition: "La convention collective est un accord negocie entre les syndicats et les employeurs d'un secteur d'activite. Elle peut prevoir des indemnites de licenciement plus favorables que le minimum legal. Le salarié beneficie toujours du calcul le plus avantageux entre la loi et sa convention."
  },
  {
    term: "CSP (Contrat de Securisation Professionnelle)",
    definition: "Le CSP est un dispositif propose aux salariés licencies pour motif economique dans les entreprises de moins de 1 000 salariés. Il prevoit un accompagnement renforce vers le retour à l'emploi et une allocation spécifique plus elevee que l'ARE pendant 12 mois."
  },
  {
    term: "Faute grave",
    definition: "La faute grave est un manquement du salarié a ses obligations contractuelles d'une gravite telle qu'il rend impossible le maintien du salarié dans l'entreprise, meme pendant la durée du préavis. Elle prive le salarié de l'indemnité de licenciement et de l'indemnité de préavis."
  },
  {
    term: "Faute lourde",
    definition: "La faute lourde est une faute d'une exceptionnelle gravite commise avec l'intention de nuire à l'employeur ou à l'entreprise. Comme la faute grave, elle prive le salarié des indemnites de licenciement et de préavis. Elle peut aussi engager la responsabilite civile du salarié."
  },
  {
    term: "Indemnité conventionnelle",
    definition: "L'indemnité conventionnelle est le montant de l'indemnité de licenciement prevu par la convention collective applicable au salarié. Si ce montant est superieur à l'indemnité légale, c'est l'indemnité conventionnelle qui s'applique."
  },
  {
    term: "Indemnité légale de licenciement",
    definition: "L'indemnité légale de licenciement est le montant minimum prevu par le Code du travail. Elle est calculee en fonction de l'ancienneté et du salaire de référence : 1/4 de mois par année pour les 10 premieres années, puis 1/3 de mois par année au-dela."
  },
  {
    term: "Licenciement economique",
    definition: "Le licenciement economique est un licenciement motive par des raisons non liees à la personne du salarié : difficultes economiques, mutations technologiques, reorganisation nécessaire à la sauvegarde de la competitivite ou cessation d'activite. Il ouvre droit a des dispositifs spécifiques (CSP, plan de sauvegarde)."
  },
  {
    term: "Plafond de sécurité sociale (PASS)",
    definition: "Le plafond annuel de sécurité sociale est un montant de référence utilise pour le calcul de certaines cotisations sociales et pour determiner les limites d'exoneration fiscale et sociale des indemnites de licenciement. Il est revalorise chaque année."
  },
  {
    term: "Plan de sauvegarde de l'emploi (PSE)",
    definition: "Le PSE est un ensemble de mesures obligatoires dans les entreprises de 50 salariés ou plus qui envisagent de licencier au moins 10 salariés sur 30 jours pour motif economique. Il vise a eviter ou limiter les licenciements et a faciliter le reclassement des salariés concernes."
  },
  {
    term: "Preavis",
    definition: "Le préavis est la période qui s'ecoule entre la notification du licenciement et la fin effective du contrat de travail. Sa durée depend de l'ancienneté du salarié et de sa catégorie professionnelle. Le salarié doit continuer a travailler pendant le préavis, sauf dispense de l'employeur."
  },
  {
    term: "Rupture conventionnelle",
    definition: "La rupture conventionnelle est un mode de rupture amiable du contrat de travail a durée indeterminee, negocie entre l'employeur et le salarié. Elle ouvre droit a une indemnité au moins egale à l'indemnité légale de licenciement et permet de percevoir l'allocation chomage."
  },
  {
    term: "Salaire de référence",
    definition: "Le salaire de référence est la base de calcul de l'indemnité de licenciement. Il correspond au montant le plus favorable entre la moyenne des 12 derniers mois de salaire brut et la moyenne des 3 derniers mois (avec prorata des primes annuelles)."
  },
  {
    term: "Solde de tout compte",
    definition: "Le solde de tout compte est un document remis au salarié à la fin de son contrat de travail. Il recapitule l'ensemble des sommes versees : dernier salaire, indemnité de licenciement, indemnité compensatrice de congés payes, indemnité de préavis et autres elements de rémunération."
  }
];
---
<Layout title="Glossaire du licenciement - Indemnité Licenciement" description="Definitions des termes cles du licenciement : indemnité légale, préavis, faute grave, rupture conventionnelle, CSP et plus encore.">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-8">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-gray-700">Accueil</a></li>
        <li>/</li>
        <li class="text-gray-800 font-medium">Glossaire</li>
      </ol>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Glossaire du licenciement</h1>
    <p class="text-gray-600 mb-8">Retrouvez les definitions des termes essentiels du droit du licenciement en France. Ce glossaire vous aide a comprendre les notions cles pour evaluer vos droits et vos indemnites.</p>

    <div class="space-y-6">
      {terms.map((item) => (
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-blue-700 mb-2">{item.term}</h2>
          <p class="text-gray-600">{item.definition}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
