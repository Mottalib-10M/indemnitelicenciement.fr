---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
}

const { title, description, canonical, schema } = Astro.props;
const siteUrl = 'https://indemnitelicenciement.fr';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Radif Partners" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Indemnité Licenciement" />

    <!-- Schema.org WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Calculateur d'Indemnité de Licenciement",
      "url": siteUrl,
      "description": "Calculez gratuitement votre indemnité de licenciement, préavis et allocation chômage (ARE) selon le Code du travail français.",
      "inLanguage": "fr",
      "publisher": {
        "@type": "Organization",
        "name": "indemnitelicenciement.fr"
      }
    })} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Radif Partners",
      "jobTitle": "Financial Technology Expert",
      "url": "https://indemnitelicenciement.fr"
    })} />

    <!-- Plausible Analytics -->
    <script defer data-domain="indemnitelicenciement.fr" src="https://plausible.io/js/script.js"></script>
    <!--
      Pas de GA4 : l'identifiant etait reste a l'etat de gabarit
      (G-XXXXXXXXXX), donc deux requetes vers googletagmanager a chaque
      page pour une mesure qui n'arrivait nulle part.
    -->
</head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <!-- Navigation -->
    <header class="sticky top-0 z-50">
      <!-- Filet tricolore : seule couleur permanente de l'en-tete. -->
      <div class="filet-tricolore h-1" aria-hidden="true"></div>
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center gap-2 text-primary-700 font-bold text-lg hover:text-primary-800 transition-colors">
            <span class="text-2xl">§</span>
            <span class="hidden sm:inline">Indemnité Licenciement</span>
          </a>

          <!-- Desktop nav -->
          <div class="hidden md:flex items-center gap-6 text-sm">
            <a href="/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">Calculateur</a>
            <a href="/guide-are/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">Guide ARE</a>
            <a href="/faq/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">FAQ</a>
            <a href="/guides/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">Guides</a>
          </div>

          <!-- Mobile hamburger button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-600 hover:text-primary-700 hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Ouvrir le menu de navigation"
          >
            <!-- Hamburger icon -->
            <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <!-- Close icon (hidden by default) -->
            <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu (hidden by default) -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
        <div class="px-4 py-3 space-y-1">
          <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-colors">Calculateur</a>
          <a href="/guide-are/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-colors">Guide ARE</a>
          <a href="/faq/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-colors">FAQ</a>
          <a href="/guides/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-primary-700 hover:bg-primary-50 transition-colors">Guides</a>
        </div>
      </div>
    </nav>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="text-white font-bold text-lg mb-2">§ Indemnité Licenciement</p>
            <p class="text-sm">
              Calculateur gratuit d'indemnité de licenciement basé sur le Code du travail français. Barèmes 2026.
            </p>
          </div>
          <div>
            <p class="text-white font-semibold mb-2">Ressources</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/" class="text-primary-200 hover:text-white transition-colors">Calculateur</a></li>
              <li><a href="/guide-are/" class="text-primary-200 hover:text-white transition-colors">Guide ARE</a></li>
              <li><a href="/faq/" class="text-primary-200 hover:text-white transition-colors">Foire aux questions</a></li>
              <li><a href="/guides/" class="text-primary-200 hover:text-white transition-colors">Tous les guides</a></li>
            </ul>
          </div>
          <div>
            <p class="text-white font-semibold mb-2">Informations légales</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/mentions-legales/" class="text-primary-200 hover:text-white transition-colors">Mentions légales</a></li>
              <li><a href="/confidentialite/" class="text-primary-200 hover:text-white transition-colors">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-800 mt-8 pt-8 text-center text-xs">
          <p>&copy; {new Date().getFullYear()} indemnitelicenciement.fr — Informations à caractère indicatif, ne constituant pas un conseil juridique.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        if (btn && menu && iconOpen && iconClose) {
          btn.addEventListener('click', function() {
            const isOpen = !menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            iconOpen.classList.toggle('hidden');
            iconClose.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', String(!isOpen));
          });
        }
      });
    </script>
  </body>
</html>
