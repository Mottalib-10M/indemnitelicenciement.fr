---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
}

const { title, description, canonical, schema } = Astro.props;
const siteUrl = 'https://indemnite-licenciement.fr';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Indemnité Licenciement" />

    <!-- Schema.org WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Calculateur d'Indemnité de Licenciement",
      "url": siteUrl,
      "description": "Calculez gratuitement votre indemnité de licenciement, préavis et allocation chômage (ARE) selon le Code du travail français.",
      "inLanguage": "fr",
      "publisher": {
        "@type": "Organization",
        "name": "indemnite-licenciement.fr"
      }
    })} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Plausible Analytics -->
    <script defer data-domain="indemnite-licenciement.fr" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center gap-2 text-primary-700 font-bold text-lg hover:text-primary-800 transition-colors">
            <span class="text-2xl">§</span>
            <span class="hidden sm:inline">Indemnité Licenciement</span>
          </a>
          <div class="flex items-center gap-4 text-sm">
            <a href="/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">Calculateur</a>
            <a href="/guide-are/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">Guide ARE</a>
            <a href="/faq/" class="text-gray-600 hover:text-primary-700 transition-colors font-medium">FAQ</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="text-white font-bold text-lg mb-2">§ Indemnité Licenciement</p>
            <p class="text-sm">
              Calculateur gratuit d'indemnité de licenciement basé sur le Code du travail français. Barèmes 2026.
            </p>
          </div>
          <div>
            <p class="text-white font-semibold mb-2">Ressources</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Calculateur</a></li>
              <li><a href="/guide-are/" class="hover:text-white transition-colors">Guide ARE</a></li>
              <li><a href="/faq/" class="hover:text-white transition-colors">Foire aux questions</a></li>
            </ul>
          </div>
          <div>
            <p class="text-white font-semibold mb-2">Informations légales</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/mentions-legales/" class="hover:text-white transition-colors">Mentions légales</a></li>
              <li><a href="/confidentialite/" class="hover:text-white transition-colors">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-800 mt-8 pt-8 text-center text-xs">
          <p>&copy; {new Date().getFullYear()} indemnite-licenciement.fr — Informations à caractère indicatif, ne constituant pas un conseil juridique.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
